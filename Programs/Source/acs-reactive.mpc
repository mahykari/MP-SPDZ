# Reactive Door Monitoring System
# Continuously processes sensor data and maintains state across iterations
# Run with: Scripts/compile-run.py <protocol> acs-reactive -- -N 3
# Parameters: <n_doors> <n_iterations>
# Example: Scripts/compile-run.py shamir acs-reactive -- -N 3 10 5

from Compiler.library import *

# Performance optimization
program.use_edabit(True)

# Parse command-line arguments
if len(program.args) >= 3:
    N_EX = int(program.args[1])           # number of external doors
    N_ITERATIONS = int(program.args[2])   # number of sensor readings to process
else:
    N_EX = 10           # default: number of external doors
    N_ITERATIONS = 5    # default: number of sensor readings to process

PORT_NUM = 14000    # Port for client connections

def spec_function(cntA_in, cntB_in, door_data):
  """
  Door monitoring specification function
  
  Args:
    cntA_in: Current count A (sint)
    cntB_in: Current count B (sint)
    door_data: List of N_EX tuples, each containing 
               (enteredA, exitedA, enteredB, exitedB) as sints
  
  Returns:
    (fault, new_cntA, new_cntB) where fault is 1 if cntA < cntB, else 0
  """
  cntA = cntA_in
  cntB = cntB_in
  
  # Process each external door
  for i in range(N_EX):
    enteredA, exitedA, enteredB, exitedB = door_data[i]
    cntA = cntA + enteredA - exitedA
    cntB = cntB + enteredB - exitedB
  
  # Check fault condition: cntA < cntB
  fault = cntA < cntB
  
  # If fault, keep original monitor values; otherwise update
  new_cntA = (1 - fault) * cntA + fault * cntA_in
  new_cntB = (1 - fault) * cntB + fault * cntB_in
  
  return fault, new_cntA, new_cntB


print_ln("="*60)
print_ln("Reactive Door Monitoring System")
print_ln("Configuration: %s doors, %s iterations", N_EX, N_ITERATIONS)
print_ln("="*60)

# Initialize state to zero
cntA = sint(0)
cntB = sint(0)
print_ln("Initialized state: cntA=0, cntB=0")

# Setup client connection for sensor data
listen_for_clients(PORT_NUM)
print_ln("Listening for sensor client on port %s", PORT_NUM)

# Accept connection from sensor client
SENSOR_CLIENT_ID = accept_client_connection(PORT_NUM)
print_ln("Sensor client connected with ID %s", SENSOR_CLIENT_ID)

# Main reactive loop - process multiple sensor readings
for iteration in range(N_ITERATIONS):
  print_ln("\n--- Iteration %s/%s ---", iteration + 1, N_ITERATIONS)
  
  # Start timing for this iteration
  start_timer(1)
  
  # Receive door data from sensor client
  # Client sends 4 values per door: enteredA, exitedA, enteredB, exitedB
  print_ln("Receiving sensor data...")
  start_timer(10)
  all_values = sint.receive_from_client(N_EX * 4, SENSOR_CLIENT_ID)
  stop_timer(10)
  
  # Parse into door_data structure
  door_data = []
  for i in range(N_EX):
    idx = i * 4
    enteredA = all_values[idx]
    exitedA = all_values[idx + 1]
    enteredB = all_values[idx + 2]
    exitedB = all_values[idx + 3]
    door_data.append((enteredA, exitedA, enteredB, exitedB))
  
  # Run the specification function
  start_timer(11)
  fault, new_cntA, new_cntB = spec_function(cntA, cntB, door_data)
  stop_timer(11)
  
  # Update state for next iteration
  cntA = new_cntA
  cntB = new_cntB
  
  # Reveal and display results
  start_timer(12)
  fault_revealed = fault.reveal()
  cntA_revealed = cntA.reveal()
  cntB_revealed = cntB.reveal()
  stop_timer(12)
  
  print_ln("Results: Fault=%s, Count A=%s, Count B=%s", 
           fault_revealed, cntA_revealed, cntB_revealed)
  
  # Send only fault bit back to sensor client
  start_timer(13)
  sint.reveal_to_clients([SENSOR_CLIENT_ID], [fault])
  stop_timer(13)
  
  # Stop total timer and print iteration metrics
  stop_timer(1)
  print_ln("Iteration %s complete - Timer 1: iteration total", iteration + 1)

# Close client connection after all iterations
closeclientconnection(SENSOR_CLIENT_ID)

# Print comprehensive metrics
print_ln("\n" + "="*60)
print_ln("EXPERIMENT COMPLETE")
print_ln("="*60)
print_ln("Configuration:")
print_ln("  Doors: %s", N_EX)
print_ln("  Iterations: %s", N_ITERATIONS)
print_ln("\nFinal State:")
print_ln("  Count A: %s", cntA.reveal())
print_ln("  Count B: %s", cntB.reveal())
print_ln("\nTiming Breakdown:")
print_ln("  Timer 1: Total iteration time")
print_ln("  Timer 10: Client data receive")
print_ln("  Timer 11: Spec function execution")
print_ln("  Timer 12: Result revelation")
print_ln("  Timer 13: Client data send")
print_ln("\nNote: Circuit complexity metrics printed below by compiler")
print_ln("="*60)
